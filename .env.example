OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Optional. Defaults to the free-tier-friendly Gemini 2.5 Flash-Lite model.
GEMINI_MODEL=gemini-2.5-flash-lite
DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
SOMNIA_WS_RPC_URL=wss://dream-rpc.somnia.network/ws
DREAMDEX_VENUE_ID=0x1a1e6821cde7d0159c0d293177871e09677b4e42307c7db3ba94f8648a5a050f
DREAMDEX_FALLBACK_VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
NEXT_PUBLIC_DREAMDEX_VENUE_ID=0x1a1e6821cde7d0159c0d293177871e09677b4e42307c7db3ba94f8648a5a050f
NEXT_PUBLIC_DREAMDEX_FALLBACK_VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c
NEXT_PUBLIC_SOMNIA_HTTP_RPC_URL=https://dream-rpc.somnia.network
DREAMPILOT_ADVICE_SIGNER_PRIVATE_KEY=
DREAMPILOT_GUARD_ADDRESS=
NEXT_PUBLIC_DREAMPILOT_GUARD_ADDRESS=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Eventra pay-on-success analysis escrow (public addresses are safe in client env).
NEXT_PUBLIC_EVENTRA_ANALYSIS_ESCROW_ADDRESS=0xc4a0e9fB3f004392c22cA4d666f8756E9e99ec8C
NEXT_PUBLIC_EVENTRA_ANALYSIS_TOKEN_ADDRESS=0x70a86D8842FB63C4Ad2b7cdddF530eBf1BB25d8E

# Dedicated server fulfiller only. Never use a wallet holding real funds and
# never prefix this variable with NEXT_PUBLIC_. Leave empty until AI APIs work.
EVENTRA_ANALYSIS_FULFILLER_PRIVATE_KEY=
SURF_API_KEY=

# demo: instant simulated orders, no wallet signature. Set to live only after
# mainnet chain, collateral, venue and allowed pools are independently verified.
NEXT_PUBLIC_EXECUTION_MODE=live

# Fail-closed: chỉ bật sau khi đối chiếu từng pool với registry/factory on-chain.
NEXT_PUBLIC_ENABLE_LIVE_TRADING=true
NEXT_PUBLIC_DREAMDEX_ALLOWED_POOLS=

# Optional override for the official Hideki v2 indexer used by /perps.
DREAMDEX_PERPS_INDEXER_URL=https://hideki-dev.smk.somnia.host/v1/graphql
